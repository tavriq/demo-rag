# Copy to .env (never commit it). Without ANTHROPIC_API_KEY the app runs in mock mode:
# search works, the answer is a stub that shows the retrieved fragments.
ANTHROPIC_API_KEY=

# Cost guard
DAILY_BUDGET_USD=1.00
RATE_LIMIT_PER_HOUR=10
MAX_TOKENS=600
MAX_QUESTION_CHARS=500

# Retrieval
TOP_K=5
RETRIEVAL_CANDIDATES=30
RRF_K=60
# Weighted RRF (1/1 is classic RRF); 1/1.5 and 350-char chunks were chosen on the dev split, see evals/tuning.md
BM25_WEIGHT=1.0
DENSE_WEIGHT=1.5
CHUNK_MAX_CHARS=350
EMBEDDING_MODEL=intfloat/multilingual-e5-small@qint8

# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# Empty = trust nobody, the TCP peer address is used for rate limiting.
TRUSTED_PROXY=
