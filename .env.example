# Copy to .env (never commit it). Create it readable by the owner only before putting a key in it:
#   install -m 600 /dev/null .env
# Without LLM_API_KEY and LLM_BASE_URL the app runs in mock mode: search works,
# the answer is a stub that shows the retrieved fragments.

# Any OpenAI-compatible API: POST {LLM_BASE_URL}/chat/completions with "Authorization: Bearer <key>".
# OpenAI itself: LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL from its model list.
LLM_API_KEY=
LLM_BASE_URL=
# The gateway's model name (default openai/gpt-5.6-terra on Timeweb AI)
LLM_MODEL=
# Reasoning models: minimal | low | medium | high. Empty = not sent. A reasoning model without
# "minimal" can spend the whole MAX_TOKENS on reasoning and return no text.
LLM_REASONING_EFFORT=
# 0 by default; "none" leaves it out for models that accept only their default temperature
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30

# Cost guard, in tokens (input + output, reasoning included), for all visitors together
DAILY_TOKEN_BUDGET=300000
HOURLY_TOKEN_BUDGET=100000
RATE_LIMIT_PER_HOUR=10
# Optional, rubles per 1M tokens. Set both to show rubles next to tokens; limits stay in tokens.
PRICE_RUB_PER_1M_INPUT=
PRICE_RUB_PER_1M_OUTPUT=
# Answer the page examples once at start (live mode only) so clicks on them are free
WARM_CACHE=1
# Completion limit per answer (sent as max_completion_tokens)
MAX_TOKENS=1000
MAX_QUESTION_CHARS=500

# Retrieval
# dense (default, chosen on the dev split, evals/tuning.md iteration 4) | hybrid | bm25
SEARCH_MODE=dense
# «статья 186.1», «ст. 84.1» in a question put that article first, in any mode
ARTICLE_ROUTER=1
TOP_K=5
RETRIEVAL_CANDIDATES=30
RRF_K=60
# Weighted RRF, used only with SEARCH_MODE=hybrid; 350-char chunks were chosen on the dev split, see evals/tuning.md
BM25_WEIGHT=1.0
DENSE_WEIGHT=1.5
CHUNK_MAX_CHARS=350
EMBEDDING_MODEL=intfloat/multilingual-e5-small@qint8

# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# Empty = trust nobody, the TCP peer address is used for rate limiting.
# Behind a proxy on the host set it to the docker gateway of this project's network, see
#   docker network inspect demo-rag_default --format '{{(index .IPAM.Config 0).Gateway}}'
# otherwise every visitor shares one rate-limit bucket (/api/health shows proxy_headers_ignored).
TRUSTED_PROXY=
